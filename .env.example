# Mars configuration. Copy to .env and edit: `cp .env.example .env`.
# The variables below are exactly those in README.md, "Configuration", in the
# same order. Every value here is a placeholder: never commit a real secret.

# The URL users open, used for cookies and email links.
PUBLIC_URL=http://localhost:8080

# Secret for signing access tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Postgres connection string (compose sets it for the orchestrator).
DATABASE_URL=postgres://mars:change-me-local-password@postgres:5432/mars

# Database bootstrap: read by the postgres container, not by the orchestrator.
POSTGRES_USER=mars
POSTGRES_PASSWORD=change-me-local-password
POSTGRES_DB=mars

# Engine socket, unix:///run/user/1000/podman/podman.sock for rootless Podman.
# With Docker instead: unix:///var/run/docker.sock
# Compose overrides this inside the orchestrator container to the mounted
# socket path (unix:///run/engine.sock); the value here is what compose itself
# and a host-run orchestrator use.
DOCKER_HOST=unix:///run/user/1000/podman/podman.sock

# Compose only: host path of the engine socket, bind-mounted into the
# orchestrator at /run/engine.sock. With Docker instead: /var/run/docker.sock
ENGINE_SOCKET_HOST=/run/user/1000/podman/podman.sock

# Host path of the data directory; mounted at /data in the orchestrator and
# used as the source of session bind mounts.
DATA_DIR_HOST=./data

# Path at which the orchestrator itself sees the data directory: /data in
# compose, the same as DATA_DIR_HOST when running on the host.
DATA_DIR=./data

# URL written into each session's MCP config; default http://orchestrator:7001/mcp.
# On a development host: http://host.containers.internal:7001/mcp
MCP_URL=http://orchestrator:7001/mcp

# Names of the two session networks; created at startup if missing.
SESSION_NETWORK_INTERNAL=mars-sessions
SESSION_NETWORK_EGRESS=mars-egress

# Optional comma-separated host:ip entries added to session containers,
# e.g. host.containers.internal:host-gateway for development.
SESSION_EXTRA_HOSTS=

# One or more <version>=<base64 32-byte key> entries, comma separated. Or set
# SECRETS_MASTER_KEY_FILE instead (exactly one of the two). Back this up
# separately from the database; without it every stored secret is unrecoverable.
# Generate a real key with: openssl rand -base64 32
# The value below is base64 of 32 zero bytes: a placeholder, never use it.
SECRETS_MASTER_KEYS=1=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# SECRETS_MASTER_KEY_FILE=/run/secrets/mars-master-keys

# Identity for commits the orchestrator creates (merges).
GIT_BOT_NAME="Mars Bot"
GIT_BOT_EMAIL=mars-bot@example.invalid

# Port of the API listener nginx proxies to (default 7000).
API_PORT=7000

# Port of the MCP listener on the sessions network (default 7001).
MCP_PORT=7001

# Compose only: host port nginx publishes. Under rootless Podman a port below
# 1024 needs net.ipv4.ip_unprivileged_port_start lowered; keep 8080.
HTTP_PORT=8080

# Seconds between SIGINT and SIGTERM when stopping a session (default 20).
STOP_GRACE_SECS=20

# How often project mirrors are fetched (default 600).
MIRROR_FETCH_INTERVAL_SECS=600

# Image used by the default profile of new projects and by the startup probe.
# Optional: leaving it unset uses the value below. Build it before the first
# start; see README.md, "Session image".
SESSION_IMAGE_DEFAULT=mars-session-claude:latest

# Email delivery through Resend, used for invites and password resets. Without
# an API key, full usable links including their tokens are intentionally
# written to the orchestrator log at info instead of sent (ADR 0026), which is
# what local development uses. MAIL_FROM is required once a key is set.
RESEND_API_KEY=
MAIL_FROM=mars@example.invalid

# Log filter, info by default.
RUST_LOG=info

# Compose only: which compose files make up the deployment, and so which
# engine it runs on (ADR 0035). With Docker instead:
# compose.yml:compose.docker.yml
COMPOSE_FILE=compose.yml:compose.podman.yml
