#!/usr/bin/env bash
# Check the operator's environment file against a release before anything is
# started with it (README.md, "Installing a published release";
# ARCHITECTURE.md, "Server deployment", "Applying"). Ships in the release
# bundle as bin/check-env.
#
#   check-env <env-file> <manifest.json>
#
# Prints one `ok` / `warn` / `FAIL` line per check and exits 1 if any check
# failed. The file is parsed line by line, never sourced, and no value is ever
# printed: a check names the variable and what is wrong with it.
set -euo pipefail

if [ "$#" -ne 2 ]; then
  echo "usage: $0 <env-file> <manifest.json>" >&2
  exit 2
fi
env_file=$1
manifest=$2

failures=0
ok() { printf 'ok    %s\n' "$*"; }
warn() { printf 'warn  %s\n' "$*"; }
fail() {
  printf 'FAIL  %s\n' "$*"
  failures=$((failures + 1))
}

if [ ! -f "$env_file" ]; then
  fail "${env_file} does not exist"
  exit 1
fi
if ! jq -e '.config.required | type == "array"' "$manifest" >/dev/null 2>&1; then
  fail "${manifest} has no config.required list"
  exit 1
fi

# The file holds the JWT secret, the database password and possibly the
# master keys: only its owner may read it.
real=$(readlink -f "$env_file")
if [ "$(stat -c %u "$real")" != "$(id -u)" ]; then
  fail "${env_file} is not owned by $(id -un)"
elif [ $(("0$(stat -c %a "$real")" & 077)) -ne 0 ]; then
  fail "${env_file} is readable by others (mode $(stat -c %a "$real")); chmod 600 it"
else
  ok "${env_file} is private to $(id -un)"
fi

# shellcheck source-path=SCRIPTDIR source=../lib/envfile.sh
. "$(dirname "$(readlink -f "$0")")/../lib/envfile.sh"
# shellcheck disable=SC2034 # filled by read_env_file, read through vars
declare -A ENV_VARS=()
ENV_BAD_LINES=()
if ! read_env_file "$env_file"; then
  for bad in "${ENV_BAD_LINES[@]}"; do fail "line ${bad} is not KEY=VALUE"; done
fi
declare -n vars=ENV_VARS

set_nonempty() { [ -n "${vars[$1]:-}" ]; }

# Every name the release requires; `A|B` is satisfied by either.
missing=0
while IFS= read -r entry; do
  found=0
  IFS='|' read -r -a names <<<"$entry"
  for name in "${names[@]}"; do
    if set_nonempty "$name"; then found=1; fi
  done
  if [ "$found" -eq 0 ]; then
    fail "${entry//|/ or } is not set"
    missing=1
  fi
done < <(jq -r '.config.required[]' "$manifest")
[ "$missing" -eq 0 ] && ok "every variable the release requires is set"

if set_nonempty SECRETS_MASTER_KEYS && set_nonempty SECRETS_MASTER_KEY_FILE; then
  fail "set exactly one of SECRETS_MASTER_KEYS and SECRETS_MASTER_KEY_FILE"
fi

# The placeholders of .env.example, which must never reach a server.
for key in JWT_SECRET POSTGRES_PASSWORD; do
  case "${vars[$key]:-}" in
  *change-me*) fail "${key} is still the .env.example placeholder" ;;
  esac
done
case "${vars[SECRETS_MASTER_KEYS]:-}" in
*AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=*) fail "SECRETS_MASTER_KEYS holds the all-zero .env.example key" ;;
esac
if set_nonempty JWT_SECRET && [ "${#vars[JWT_SECRET]}" -lt 32 ]; then
  fail "JWT_SECRET is shorter than 32 characters"
fi

# compose interpolates it into DATABASE_URL (README.md, "Configuration").
if set_nonempty POSTGRES_PASSWORD && ! [[ "${vars[POSTGRES_PASSWORD]}" =~ ^[A-Za-z0-9._~-]+$ ]]; then
  fail "POSTGRES_PASSWORD has characters that are not URL-safe (letters, digits, - _ . ~)"
fi

case "${vars[PUBLIC_URL]:-}" in
https://*) ok "PUBLIC_URL is https" ;;
'') ;;
*) warn "PUBLIC_URL is not https: the session cookie is not marked Secure" ;;
esac

data=${vars[DATA_DIR_HOST]:-}
if [ -n "$data" ]; then
  if [[ "$data" != /* ]]; then
    fail "DATA_DIR_HOST is not an absolute path"
  elif [ ! -d "$data" ]; then
    fail "DATA_DIR_HOST does not exist"
  elif [ ! -w "$data" ]; then
    fail "DATA_DIR_HOST is not writable by $(id -un)"
  else
    ok "DATA_DIR_HOST is an absolute, writable directory"
  fi
fi

socket=${vars[ENGINE_SOCKET_HOST]:-}
if [ -n "$socket" ]; then
  if [ -S "$socket" ]; then
    ok "ENGINE_SOCKET_HOST is a socket"
  else
    fail "ENGINE_SOCKET_HOST is not a socket; is podman.socket running for $(id -un)?"
  fi
fi

# The database server is the operator's, pinned by digest so no pull ever
# changes it (ARCHITECTURE.md, "Server deployment", "Rollback and restore").
postgres_image=${vars[POSTGRES_IMAGE]:-}
major=$(jq -r '.postgres.major' "$manifest")
if [ -z "$postgres_image" ]; then
  warn "POSTGRES_IMAGE is unset, so compose uses the mutable postgres:${major} tag; pin it by digest"
elif ! [[ "$postgres_image" =~ @sha256:[0-9a-f]{64}$ ]]; then
  warn "POSTGRES_IMAGE is not pinned by digest"
else
  ok "POSTGRES_IMAGE is pinned by digest"
fi

if [ "$failures" -ne 0 ]; then
  echo "${failures} check(s) failed"
  exit 1
fi
