  "query": "\n            INSERT INTO task_sessions (task_id, session_id)\n            VALUES ($1, $2)\n            ON CONFLICT (task_id, session_id) DO UPDATE SET last_touched_at = NOW()\n            RETURNING task_id, session_id, first_touched_at, last_touched_at\n            ",
