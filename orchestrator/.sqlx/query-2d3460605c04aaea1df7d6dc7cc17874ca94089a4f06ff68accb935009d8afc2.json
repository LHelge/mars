  "query": "\n            SELECT d.task_id\n            FROM task_dependencies AS d\n            JOIN tasks AS t ON t.id = d.task_id\n            WHERE d.depends_on_task_id = $1 AND d.kind = $2 AND t.project_id = $3\n            ORDER BY d.task_id\n            ",
