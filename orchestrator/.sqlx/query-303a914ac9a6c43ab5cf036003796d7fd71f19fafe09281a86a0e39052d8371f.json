  "query": "\n            SELECT id, email, token_hash, admin, invited_by, expires_at,\n                   accepted_at, accepted_user_id, created_at\n            FROM user_invites\n            WHERE token_hash = $1 AND accepted_at IS NULL AND expires_at > NOW()\n            FOR UPDATE\n            ",
