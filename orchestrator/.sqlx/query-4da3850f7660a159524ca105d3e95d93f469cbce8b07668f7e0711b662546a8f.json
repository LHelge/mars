  "db_name": "PostgreSQL",
  "query": "\n            UPDATE secrets\n            SET ciphertext = $2,\n                nonce = $3,\n                data_key_wrapped = $4,\n                data_key_nonce = $5,\n                key_version = $6,\n                updated_at = NOW()\n            WHERE id = $1\n            RETURNING id, scope AS \"scope: SecretScope\", scope_id, name, ciphertext, nonce,\n                      data_key_wrapped, data_key_nonce, key_version, orchestrator_only,\n                      created_by, created_at, updated_at\n            ",
