  "query": "\n            UPDATE users\n            SET password_hash = $2,\n                auth_version = auth_version + 1,\n                must_change_password = FALSE,\n                updated_at = NOW()\n            WHERE id = $1\n            RETURNING id, username, email, password_hash, auth_version,\n                      must_change_password, admin, notify_email, created_at, updated_at\n            ",
