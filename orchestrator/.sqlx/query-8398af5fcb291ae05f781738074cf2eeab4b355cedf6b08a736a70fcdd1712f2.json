{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT c.id, c.task_id, c.author_user_id, c.author_session_id, c.system, c.body,\n                   c.created_at\n            FROM task_comments AS c\n            JOIN tasks AS t ON t.id = c.task_id\n            WHERE c.task_id = $1 AND t.project_id = $2\n            ORDER BY c.created_at, c.id\n            ",
