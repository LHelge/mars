  "query": "\n            SELECT name\n            FROM secrets\n            WHERE scope = $1\n              AND scope_id IS NOT DISTINCT FROM $2\n              AND name = ANY($3)\n              AND ($4::uuid IS NULL OR id <> $4)\n            ORDER BY name\n            LIMIT 1\n            ",
